{
  "name": "dzencode_inventory_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch server.ts --exec ts-node --project tsconfig.server.json server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production ts-node --project tsconfig.server.json server.ts",
    "build:server": "tsc --project tsconfig.server.json",
    "start:prod": "cross-env NODE_ENV=production node dist/server.js",
    "lint": "next lint",
    "test": "jest",
    "prisma:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "db:setup": "prisma db push && npm run prisma:seed",
    "setup": "npm install && npm run db:setup",
    "start:docker": "npm run db:setup && npm run build && npm run build:server && npm run start:prod"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@libsql/client": "^0.15.15",
    "@prisma/adapter-libsql": "^7.2.0",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.13.2",
    "bootstrap": "^5.3.8",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.26",
    "next": "16.1.1",
    "next-intl": "^4.7.0",
    "react": "19.2.3",
    "react-bootstrap": "^2.10.10",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.69.0",
    "react-redux": "^9.2.0",
    "recharts": "^3.6.0",
    "sass": "^1.97.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.27",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/socket.io": "^3.0.1",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "nodemon": "^3.1.11",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
